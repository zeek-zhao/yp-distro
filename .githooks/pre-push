#!/usr/bin/env bash
# 阻止直接推送到 main：main 只接受来自 dev 的 PR。
# 紧急放行：ALLOW_MAIN_PUSH=1 git push origin main
set -u
blocked=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            if [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
                printf '\n[pre-push] 拒绝直接推送到 main\n' >&2
                printf '  流程：feat/* → PR → dev →（阶段收口）PR → main\n' >&2
                printf '  紧急放行：ALLOW_MAIN_PUSH=1 git push origin main\n' >&2
                printf '  说明：docs/06-process/branching.md §4\n\n' >&2
                blocked=1
            fi
            ;;
    esac
done
exit "$blocked"
