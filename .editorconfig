root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# shfmt 读这段配置；容器内 `shfmt -d` 与 CI 的检查口径以这里为准
[*.sh]
indent_style = space
indent_size = 4
switch_case_indent = true
binary_next_line = false

[*.bats]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
